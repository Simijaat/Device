<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:top="6dp"
        android:bottom="6dp"
        android:left="8dp"
        android:right="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="135"
                android:startColor="#B5FFFFFF"
                android:centerColor="#65FFFFFF"
                android:endColor="#95FFFFFF"
                android:type="linear" />
            <stroke
                android:width="1.8dp"
                android:color="#FFFFFFFF" />
        </shape>
    </item>
</layer-list>

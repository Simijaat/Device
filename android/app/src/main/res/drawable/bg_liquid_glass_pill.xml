<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer soft refractive aura -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="135"
                android:startColor="#85FFFFFF"
                android:centerColor="#45E2E8F0"
                android:endColor="#75FFFFFF"
                android:type="linear" />
            <stroke
                android:width="1.8dp"
                android:color="#E6FFFFFF" />
        </shape>
    </item>
    <!-- Inner specular top rim bevel -->
    <item
        android:top="1.5dp"
        android:bottom="1.5dp"
        android:left="2dp"
        android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="270"
                android:startColor="#60FFFFFF"
                android:centerColor="#20FFFFFF"
                android:endColor="#45FFFFFF"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#80FFFFFF" />
        </shape>
    </item>
</layer-list>

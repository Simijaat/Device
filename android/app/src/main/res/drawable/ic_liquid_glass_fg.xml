                <item android:color="#C0FFFFFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Dynamic Island / Sensor Pill -->
    <path
        android:fillColor="#E0FFFFFF"
        android:pathData="M51,32.5 L57,32.5 C57.8,32.5 58.5,33.2 58.5,34 C58.5,34.8 57.8,35.5 57,35.5 L51,35.5 C50.2,35.5 49.5,34.8 49.5,34 C49.5,33.2 50.2,32.5 51,32.5 Z" />


    <path
        android:pathData="M21,34 C21,27 25,23 32,23 L76,23 C81,23 85,25 86,29 C70,36 40,48 21,72 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="30"
                android:startY="23"
                android:endX="70"
                android:endY="60">
                <item android:color="#4AFFFFFF" android:offset="0.0" />
                <item android:color="#18FFFFFF" android:offset="0.5" />
                <item android:color="#00FFFFFF" android:offset="1.0" />

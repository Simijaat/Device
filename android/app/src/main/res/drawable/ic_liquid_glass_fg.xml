                android:startX="20"
                android:startY="22"
                android:endX="88"
                android:endY="86">
                <item android:color="#35FFFFFF" android:offset="0.0" />
                <item android:color="#1500F2FE" android:offset="0.3" />
                <item android:color="#0A7F00FF" android:offset="0.7" />
                <item android:color="#20FFFFFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>


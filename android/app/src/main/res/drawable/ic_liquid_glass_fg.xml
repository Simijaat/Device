                <item android:color="#B01E293B" android:offset="0.6" />
                <item android:color="#800F172A" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Device Inner Screen Glass -->
    <path
        android:pathData="M37,35 L71,35 L71,69 L37,69 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="37"

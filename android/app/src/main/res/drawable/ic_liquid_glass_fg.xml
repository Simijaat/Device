                android:type="radial"
                android:centerX="53"
                android:centerY="52"
                android:gradientRadius="4.5">
                <item android:color="#FFFFFFFF" android:offset="0.0" />
                <item android:color="#FF38BDF8" android:offset="0.6" />
                <item android:color="#FF0284C7" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bottom Navigation Bar Home Bar -->
    <path
        android:fillColor="#90FFFFFF"
        android:pathData="M48,74 L60,74 C60.6,74 61,74.4 61,75 C61,75.6 60.6,76 60,76 L48,76 C47.4,76 47,75.6 47,75 C47,74.4 47.4,74 48,74 Z" />


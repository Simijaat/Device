        android:strokeWidth="1.6">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="20"
                android:startY="22"
                android:endX="88"
                android:endY="86">
                <item android:color="#E0FFFFFF" android:offset="0.0" />

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="96dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device Dashboard"
            android:textColor="#0F172A"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Liquid Glass Telemetry &amp; Sync Control"
            android:textColor="#475569"
            android:textSize="13sp"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnSyncAll"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Sync All Authorized Data"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:backgroundTint="#4F46E5"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_liquid_glass_card"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Location: Loading..."
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvContacts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Contacts: 0"
                android:textColor="#1E293B"
                android:textSize="15sp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvSms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Messages: 0"
                android:textColor="#1E293B"
                android:textSize="15sp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvCalls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calls: 0"
                android:textColor="#1E293B"
                android:textSize="15sp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvApps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Apps: 0"
                android:textColor="#1E293B"
                android:textSize="15sp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>

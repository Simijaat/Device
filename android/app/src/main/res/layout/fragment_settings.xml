<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <Switch
        android:id="@+id/switchMasterCollection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Master Collection Enabled"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"/>

    <Switch
        android:id="@+id/switchWifiOnly"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sync on Wi-Fi Only"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"/>

    <Switch
        android:id="@+id/switchAutoDelete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Auto-delete local data after sync"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"/>

</LinearLayout>
